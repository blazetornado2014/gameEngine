# LLM API Configuration Example
# Copy this file to .env and fill in your actual API keys

# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# Anthropic Configuration  
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-sonnet-20240229
ANTHROPIC_MAX_TOKENS=2000

# Google AI Configuration (optional)
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=your-google-ai-key-here
GOOGLE_AI_MODEL=gemini-pro

# Application Configuration
NODE_ENV=development
LLM_PROVIDER=openai
DEBUG_LLM_REQUESTS=true
ENABLE_GAME_GENERATION=true

# Game Engine Configuration
DEFAULT_CANVAS_WIDTH=800
DEFAULT_CANVAS_HEIGHT=600
DEFAULT_WIN_TIME=60
DEFAULT_ENEMY_SPAWN_RATE=3000

# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Get API keys from the URLs above
# 3. Replace the placeholder values with your actual keys
# 4. Choose your preferred LLM_PROVIDER (openai, anthropic, or google)
# 5. The .env file will be ignored by git to keep your keys secure